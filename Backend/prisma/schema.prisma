generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================= ENUMS =======================
enum Role {
  Client
  Expert
}

enum STATUS {
  COMPLETED
  PENDING
  CONFIRMED
  REJECTED
}

// ======================= MODELS =======================
model User {
  id          Int       @id @default(autoincrement())
  username    String
  email       String    @unique
  password    String
  phoneNumber String
  role        Role
  experts     Expert?   // one-to-one with Expert if user is an expert
  bookings    Booking[] // bookings made by user
  reviews     Review[]  // reviews given by user
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Category {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  experts Expert[]
}

model Expert {
  id          Int       @id @default(autoincrement())
  bio         String    @db.Text
  city        String
  priceStart  Decimal
  rating      Float     @default(0.0)
  experience  Int
  profilePic  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      Int       @unique
  user        User      @relation(fields: [userId], references: [id])
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])

  bookings    Booking[]
  reviews     Review[]
}

model Booking {
  id          Int      @id @default(autoincrement())
  date        DateTime
  status      STATUS   @default(PENDING)
  description String
  userId      Int
  expertId    Int

  client      User     @relation(fields: [userId], references: [id])
  expert      Expert   @relation(fields: [expertId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  clientId  Int
  expertId  Int

  client    User     @relation(fields: [clientId], references: [id])
  expert    Expert   @relation(fields: [expertId], references: [id])
}

