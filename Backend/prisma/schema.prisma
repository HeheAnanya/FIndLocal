generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum Role {
  Client
  Expert
}
model User {
  id   Int    @id @default(autoincrement())
  username String
  email String @unique
  password String
  phoneNumber String
  role Role
  experts Expert?
  bookings    Booking[]
}
model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
}
model Category {
  id Int @id @default(autoincrement())
  name String @unique
  experts Expert[]
}

model Expert{
  id          Int      @id @default(autoincrement())
  bio         String   @db.Text 
  city        String
  priceStart  Decimal  
  rating      Float    @default(0.0)
  userId      Int      @unique
  experience Int
  user        User     @relation(fields: [userId], references: [id])
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  bookings    Booking[]
}
enum STATUS {
  COMPLETED 
  PENDING 
  CONFIRMED
  REJECTED
}
model Booking {
  id Int @id @default(autoincrement())
  date DateTime
  status STATUS @default(PENDING)
  userId  Int
  description String
  client User @relation(fields: [userId], references: [id])
  expertId    Int
  expert Expert @relation(fields: [expertId], references: [id])
}